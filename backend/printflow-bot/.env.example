# API key Groq (gratis, tanpa kartu). Dapatkan di https://console.groq.com/keys
GROQ_API_KEY=isi-api-key-anda

# Model Groq yang dipakai untuk analisis pesan customer
GROQ_MODEL=llama-3.3-70b-versatile

# Nama toko, dipakai pada balasan otomatis
STORE_NAME=EL-MUFID

# Nomor admin (opsional), format: 62812xxxxxxx, untuk fitur eskalasi di masa depan
ADMIN_NUMBER=

# Folder penyimpanan sesi login WhatsApp (Baileys auth state)
SESSION_FOLDER=./session

# Nomor WhatsApp bot (opsional). Isi format: 62812xxxxxxx (kode negara, tanpa + atau 0 di depan)
# Jika diisi, login pakai kode pairing (tanpa scan QR). Jika dikosongkan, login pakai scan QR seperti biasa.
WA_PHONE_NUMBER=

# Port server status WA (dipakai printflow-dashboard untuk menampilkan QR & status koneksi)
API_PORT=3001

# Supabase (sama seperti yang dipakai printflow-dashboard) -- untuk simpan
# order & stock dari chat WA dan notifikasi status. Pakai SERVICE ROLE key,
# bukan anon key.
SUPABASE_URL=isi-supabase-url-anda
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-key-anda
